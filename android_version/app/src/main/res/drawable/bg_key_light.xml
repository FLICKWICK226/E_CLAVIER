<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40000000">
    <item>
        <layer-list>
            <!-- Ombre inférieure pour effet de touche mécanique -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#B2D8B5" />
                </shape>
            </item>
            <!-- Corps de la touche utilisateur #D1EDD3 -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/key_bg_light" />
                    <stroke android:width="0.5dp" android:color="@color/key_border_light" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
